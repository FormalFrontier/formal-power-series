module

import FormalPowerSeries.MvPowerSeries.IdealAdicRestricted.LinearQuotient

/-!
# Scalar coefficients of adically restricted power series

Scalar multiplication acts coefficientwise, including on the constant coefficient
of the unit over the integers with the ideal generated by four.
-/

variable {σ R : Type*} [CommRing R]

example (I : Ideal R) (r : R)
    (f : MvPowerSeries.adicallyRestrictedSubring (σ := σ) I)
    (m : σ →₀ ℕ) :
    MvPowerSeries.coeff m
        ((r • f : MvPowerSeries.adicallyRestrictedSubring (σ := σ) I) :
          MvPowerSeries σ R) =
      r * MvPowerSeries.coeff m (f : MvPowerSeries σ R) := by
  exact MvPowerSeries.coeff_smul_adicallyRestricted I r f m

example :
    let I : Ideal ℤ := Ideal.span ({4} : Set ℤ)
    let f : MvPowerSeries.adicallyRestrictedSubring (σ := Fin 2) I := 1
    let c : ℤ := MvPowerSeries.coeff (0 : Fin 2 →₀ ℕ)
      (((2 : ℤ) • f : MvPowerSeries.adicallyRestrictedSubring (σ := Fin 2) I) :
        MvPowerSeries (Fin 2) ℤ)
    c = 2 ∧ c ≠ 0 := by
  dsimp only
  norm_num
  let S : Subring (MvPowerSeries (Fin 2) ℤ) :=
    MvPowerSeries.adicallyRestrictedSubring (σ := Fin 2) (Ideal.span ({4} : Set ℤ))
  let h : S →+* ℤ := MvPowerSeries.constantCoeff.comp S.subtype
  have h₂ : h (2 : S) = (2 : ℤ) := by
    calc
      h 2 = h ((1 : S) + 1) := congrArg h (by norm_num)
      _ = h 1 + h 1 := RingHom.map_add h 1 1
      _ = 2 := by norm_num only [RingHom.map_one]
  have hc₂ : MvPowerSeries.constantCoeff ((2 : S) : MvPowerSeries (Fin 2) ℤ) =
      (2 : ℤ) := h₂
  exact ⟨hc₂, by
    simpa only [hc₂] using (show (2 : ℤ) ≠ 0 by norm_num)⟩
